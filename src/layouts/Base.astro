---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CtaBand, { type Props as CtaProps } from '../components/CtaBand.astro';
import { assertLaunchReady, business } from '../lib/config';
import { copy } from '../lib/copy';

interface Props {
  title?: string;
  description?: string;
  cta?: CtaProps | false;
}

const { title = business.name, description = business.tagline, cta = {} } = Astro.props;
assertLaunchReady(`<title> on ${Astro.url.pathname}`, title);
assertLaunchReady(`meta description on ${Astro.url.pathname}`, description);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F6F4" />
    <link rel="preload" href="/fonts/zilla-slab-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
      {cta && <CtaBand {...cta} />}
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>

<style>
  .scroll-sentinel {
    position: absolute;
    top: 40px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  main:focus {
    outline: none;
  }
</style>
