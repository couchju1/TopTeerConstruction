---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CtaBand, { type Props as CtaProps } from '../components/CtaBand.astro';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import { analyticsProvider } from '../lib/analytics';
import siteConfig from '../../site.config.json';
import { assertLaunchReady, business } from '../lib/config';
import { breadcrumbJsonLd, businessJsonLd } from '../lib/schema';
import { copy } from '../lib/copy';

interface Props {
  title?: string;
  description?: string;
  cta?: CtaProps | false;
  noindex?: boolean;
  canonical?: boolean;
  schema?: object[];
}

const { title = business.name, description = business.tagline, cta = {}, noindex = false, canonical = true, schema = [] } = Astro.props;
assertLaunchReady(`<title> on ${Astro.url.pathname}`, title);
assertLaunchReady(`meta description on ${Astro.url.pathname}`, description);

const breadcrumb = canonical ? breadcrumbJsonLd(Astro.url.pathname) : null;
const jsonLd = [businessJsonLd(), ...(breadcrumb ? [breadcrumb] : []), ...schema];
---
<!doctype html>
<html lang="en" data-analytics={analyticsProvider() ?? undefined} data-analytics-id={siteConfig.analytics.id || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} canonical={canonical} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F6F6F4" />
    <link rel="preload" href="/fonts/zilla-slab-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
      {cta && <CtaBand {...cta} />}
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>

<style>
  .scroll-sentinel {
    position: absolute;
    top: 40px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  main:focus {
    outline: none;
  }
</style>
