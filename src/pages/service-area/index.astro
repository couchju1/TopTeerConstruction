---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import Section from '../../components/Section.astro';
import ServiceAreaMap from '../../components/ServiceAreaMap.astro';
import { location, shownInBuild } from '../../lib/config';
import { serviceAreaCopy as copy } from '../../lib/page-copy';
import { townCoordinates } from '../../lib/towns';

const base = townCoordinates[location.city];
const milesFromBase = (town: string) => {
  const t = townCoordinates[town];
  if (!t || !base) return null;
  const toRad = (d: number) => (d * Math.PI) / 180;
  const dLat = toRad(t.lat - base.lat);
  const dLng = toRad(t.lng - base.lng);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(base.lat)) * Math.cos(toRad(t.lat)) * Math.sin(dLng / 2) ** 2;
  return Math.round(3959 * 2 * Math.asin(Math.sqrt(a)));
};

const towns = location.serviceTowns
  .map((town) => {
    const miles = milesFromBase(town);
    const text =
      town === location.city
        ? `${town} is home base. Most jobs here, I can come look at the same week you call.`
        : miles !== null
          ? `${town} is about ${miles} miles from home base in ${location.city}, close enough that I can be on site the same week you call.`
          : `${town} is in my regular service area. Call and I will set a time to come look.`;
    return { town, text };
  })
  .filter((t) => shownInBuild(t.text));
---
<Base title={copy.title} description={copy.description}>
  <Section aria-labelledby="service-area-heading">
    <h1 id="service-area-heading"><Fact text={copy.h1} name="Service area heading" /></h1>
    <p class="service-area-intro"><Fact text={copy.intro} name="Service area intro" /></p>
    <ServiceAreaMap size="large" />
  </Section>

  {
    towns.length > 0 && (
      <Section tone="white" aria-label="Towns">
        <ul class="service-area-towns" role="list">
          {towns.map((t, i) => (
            <li>
              <h2 id={`town-${i}`}>{t.town}</h2>
              <p><Fact text={t.text} name={`${t.town} paragraph`} /></p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Base>

<style>
  .service-area-intro {
    max-width: 52ch;
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .service-area-towns {
    display: grid;
    gap: 0 var(--space-7);
  }

  @media (min-width: 48rem) {
    .service-area-towns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-area-towns li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .service-area-towns h2 {
    font-size: var(--step-2);
  }
</style>
