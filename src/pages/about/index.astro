---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import Picture from '../../components/Picture.astro';
import Section from '../../components/Section.astro';
import { credentials, shownInBuild } from '../../lib/config';
import { aboutCopy as copy } from '../../lib/page-copy';
import photo from '../../assets/photos/chad-erickson.jpg';

const paperwork = [
  { label: 'Insurance', field: 'credentials.insured', value: credentials.insured },
  { label: 'Insurance carrier', field: 'credentials.insuranceCarrier', value: credentials.insuranceCarrier },
  { label: 'Sioux Falls contractor license', field: 'credentials.siouxFallsContractorLicense', value: credentials.siouxFallsContractorLicense },
  { label: 'Warranty', field: 'credentials.warranty', value: credentials.warranty },
].filter((line) => shownInBuild(line.value));
---
<Base title={copy.title} description={copy.description}>
  <section class="about-hero container" aria-labelledby="about-heading">
    <h1 id="about-heading"><Fact text={copy.h1} name="About heading" /></h1>
  </section>

  <Section grid="5-7" aria-label="My story" class="about-story">
    <div class="about-photo">
      <Picture src={photo} alt={copy.photoAlt} sizes="(min-width: 48rem) 30vw, 100vw" priority />
    </div>
    <div class="about-story-text">
      {copy.story.map((para, i) => <p><Fact text={para} name={`Story paragraph ${i + 1}`} /></p>)}
    </div>
  </Section>

  <Section tone="white" grid="5-7" aria-labelledby="about-run">
    <h2 id="about-run">{copy.runHeading}</h2>
    <ul class="about-list" role="list">
      {copy.run.map((item, i) => <li><Fact text={item} name={`How I run a job ${i + 1}`} /></li>)}
    </ul>
  </Section>

  {
    paperwork.length > 0 && (
      <Section grid="5-7" aria-labelledby="about-paperwork">
        <h2 id="about-paperwork">{copy.paperworkHeading}</h2>
        <dl class="about-paperwork">
          {paperwork.map((line) => (
            <div>
              <dt>{line.label}</dt>
              <dd><Fact field={line.field} /></dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }
</Base>

<style>
  .about-hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) 0;
  }


  .about-photo {
    aspect-ratio: 1;
    max-width: 26rem;
    overflow: hidden;
  }

  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-story-text {
    display: grid;
    gap: var(--space-5);
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .about-list li {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--step-1);
  }

  .about-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.35em;
    width: 1rem;
    height: 2px;
    background: var(--color-accent);
  }

  .about-paperwork div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 36rem) {
    .about-paperwork div {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-5);
    }
  }

  .about-paperwork dt {
    font-weight: 600;
  }
</style>
