---
import Service from '../../layouts/Service.astro';
import Fact from '../../components/Fact.astro';
import Section from '../../components/Section.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { newConstructionCopy as copy } from '../../lib/service-copy';
---
<Service slug="new-construction" hero="wide" {...copy}>
  <Section tone="white" aria-labelledby="how-i-work">
    <h2 id="how-i-work" class="new-construction-heading">{copy.howHeading}</h2>
    <ul class="new-construction-how" role="list">
      {
        copy.how.map((item, i) => (
          <li>
            <h3><Fact text={item.title} name={`How ${i + 1} title`} /></h3>
            <p><Fact text={item.body} name={`How ${i + 1} body`} /></p>
          </li>
        ))
      }
    </ul>
  </Section>

  <ServiceGallery service="new-construction" heading={copy.galleryHeading} />
</Service>

<style>
  .new-construction-heading {
    margin-bottom: var(--space-6);
  }

  .new-construction-how li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 48rem) {
    .new-construction-how li {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-7);
    }
  }

  .new-construction-how p {
    max-width: 52ch;
  }
</style>
