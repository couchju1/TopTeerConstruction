---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Fact from '../components/Fact.astro';
import { business, telHref } from '../lib/config';
import { notFoundCopy as copy } from '../lib/page-copy';
---
<Base title={copy.title} description={copy.description} cta={false} noindex>
  <section class="not-found container" aria-labelledby="not-found-heading">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-heading"><Fact text={copy.h1} name="404 heading" /></h1>
    <p><Fact text={copy.body} name="404 body" /></p>
    <div class="not-found-actions">
      <Button href={telHref}>Call {business.owner}</Button>
      <Button variant="secondary" href="/">{copy.home}</Button>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-9);
  }

  .not-found-code {
    font-family: var(--font-display-stack);
    font-size: clamp(4rem, 3rem + 6vw, 8rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-accent);
  }

  .not-found p:not(.not-found-code) {
    max-width: 44ch;
    font-size: var(--step-1);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
