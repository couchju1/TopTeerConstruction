---
import Base from '../../layouts/Base.astro';
import Accordion from '../../components/Accordion.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import Picture from '../../components/Picture.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import Reviews from '../../components/Reviews.astro';
import Section from '../../components/Section.astro';
import ServiceList from '../../components/ServiceList.astro';
import { services } from '../../lib/config';
import { faqPageJsonLd, type FaqItem } from '../../lib/faq';
import hero from '../../assets/photos/placeholder-hero.jpg';
import before from '../../assets/photos/placeholder-before.jpg';
import after from '../../assets/photos/placeholder-after.jpg';
import square from '../../assets/photos/placeholder-square.jpg';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'components' } }] : [];
}

const thumbs = Object.fromEntries(services.map((s) => [s.slug, square]));

const steps = [
  { title: 'Sample step one', body: 'Sample body text for layout only.' },
  { title: 'Sample step two', body: 'Sample body text for layout only.' },
  { title: 'Sample step three', body: 'Sample body text for layout only.' },
  { title: 'Sample step four', body: 'Sample body text for layout only.' },
];

const faqs: FaqItem[] = [
  { question: 'Sample question one?', answer: 'Sample answer for layout only.' },
  { question: 'Sample question two?', answer: 'Sample answer for layout only.' },
];

const sampleReviews = [
  { name: 'Sample A', town: 'Tea', text: 'Sample review text for layout only.' },
  { name: 'Sample B', town: 'Harrisburg', text: 'Sample review text for layout only.' },
  { name: 'Sample C', town: 'Sioux Falls', text: 'Sample review text for layout only.' },
];
---
<Base title="Components (dev only)" cta={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <Section tone="white">
    <h1>Components</h1>
    <p>Dev only. This page is not built. Hover, focus and press the controls to see those states.</p>
  </Section>

  <Section tone="limestone" aria-labelledby="dev-buttons">
    <h2 id="dev-buttons">Button on limestone</h2>
    <div class="dev-row">
      <Button href="/free-estimate/">Primary link</Button>
      <Button>Primary button</Button>
      <Button href="/free-estimate/" disabled>Primary disabled link</Button>
      <Button disabled>Primary disabled</Button>
    </div>
    <div class="dev-row">
      <Button variant="secondary" href="/about/">Secondary link</Button>
      <Button variant="secondary">Secondary button</Button>
      <Button variant="secondary" disabled>Secondary disabled</Button>
    </div>
  </Section>

  <Section tone="spruce" aria-labelledby="dev-buttons-dark">
    <h2 id="dev-buttons-dark">Button on spruce</h2>
    <div class="dev-row">
      <Button href="/free-estimate/">Primary link</Button>
      <Button disabled>Primary disabled</Button>
      <Button variant="secondary" onDark href="/about/">Secondary link</Button>
      <Button variant="secondary" onDark disabled>Secondary disabled</Button>
    </div>
  </Section>

  <Section tone="white" grid="7-5" aria-labelledby="dev-grid-75">
    <div>
      <h2 id="dev-grid-75">Section white, grid 7-5</h2>
      <p>Left column spans seven twelfths.</p>
    </div>
    <Picture src={hero} alt="Placeholder image" sizes="(min-width: 64rem) 30rem, 100vw" priority />
  </Section>

  <Section tone="limestone" grid="5-7" aria-labelledby="dev-grid-57">
    <Picture src={square} alt="" decorative sizes="(min-width: 64rem) 25rem, 100vw" />
    <div>
      <h2 id="dev-grid-57">Section limestone, grid 5-7, decorative image</h2>
      <p>Right column spans seven twelfths.</p>
    </div>
  </Section>

  <Section tone="spruce" grid="8-4" aria-labelledby="dev-grid-84">
    <div>
      <h2 id="dev-grid-84">Section spruce, grid 8-4</h2>
      <p>Left column spans eight twelfths.</p>
    </div>
    <p>Side note.</p>
  </Section>

  <Section tone="white" width="full" aria-labelledby="dev-full">
    <h2 id="dev-full" class="dev-pad">Section full width</h2>
  </Section>

  <Section tone="white" aria-labelledby="dev-proof">
    <h2 id="dev-proof">ProofStrip</h2>
    <ProofStrip items={['Sample fact one', 'Sample fact two', 'Sample fact three']} />
  </Section>

  <Section aria-labelledby="dev-services">
    <h2 id="dev-services">ServiceList with thumbnails</h2>
    <ServiceList thumbs={thumbs} />
    <h2 class="dev-gap">ServiceList without thumbnails</h2>
    <ServiceList />
  </Section>

  <Section tone="white" aria-labelledby="dev-ba">
    <h2 id="dev-ba">BeforeAfter</h2>
    <BeforeAfter
      before={before}
      after={after}
      beforeAlt="Placeholder before photo"
      afterAlt="Placeholder after photo"
      caption="Sample caption for layout only."
    />
  </Section>

  <Section tone="spruce" aria-labelledby="dev-steps">
    <h2 id="dev-steps">ProcessSteps track on spruce</h2>
    <ProcessSteps steps={steps} />
  </Section>

  <Section aria-labelledby="dev-steps-v">
    <h2 id="dev-steps-v">ProcessSteps vertical</h2>
    <ProcessSteps steps={steps} layout="vertical" />
  </Section>

  <Section tone="white" aria-labelledby="dev-faq">
    <h2 id="dev-faq">Accordion with FAQPage schema from the slot</h2>
    <Accordion items={faqs}>
      {(items: FaqItem[]) => <script type="application/ld+json" set:html={JSON.stringify(faqPageJsonLd(items))} />}
    </Accordion>
  </Section>

  <Section aria-labelledby="dev-reviews">
    <h2 id="dev-reviews">Reviews from config (renders nothing below the minimum)</h2>
    <Reviews />
    <p class="dev-note">Sample reviews:</p>
    <Reviews items={sampleReviews} />
  </Section>

  <CtaBand label="Get a free deck estimate" />
</Base>

<style>
  .dev-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .dev-gap,
  .dev-note {
    margin-block: var(--space-7) var(--space-4);
  }

  .dev-pad {
    padding-inline: var(--gutter);
  }
</style>
