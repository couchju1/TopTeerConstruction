---
import Service from '../../layouts/Service.astro';
import Fact from '../../components/Fact.astro';
import FaqSection from '../../components/FaqSection.astro';
import Section from '../../components/Section.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { remodelingCopy as copy } from '../../lib/service-copy';
---
<Service slug="remodeling" hero="split" {...copy}>
  {
    copy.rooms.map((room, index) => (
      <Section tone={index % 2 === 0 ? 'white' : 'limestone'} aria-labelledby={`room-${index}`} class="remodeling-room">
        <div class="remodeling-room-text">
          <p class="remodeling-room-timeline"><Fact text={room.timeline} name={`${room.name} timeline`} /></p>
          <h2 id={`room-${index}`}>{room.name}</h2>
          <p><Fact text={room.body} name={`${room.name} body`} /></p>
        </div>
      </Section>
    ))
  }

  <Section tone="spruce" width="full" aria-labelledby="behind-wall" class="remodeling-behind">
    <div class="container remodeling-behind-inner">
      <h2 id="behind-wall">{copy.behindHeading}</h2>
      <p><Fact text={copy.behindBody} name="Behind the wall body" /></p>
    </div>
  </Section>

  <ServiceGallery service="remodeling" heading={copy.galleryHeading} />
  <FaqSection heading={copy.faqHeading} items={copy.faqs} />
</Service>

<style>
  .remodeling-room-text {
    display: grid;
    gap: var(--space-3);
    max-width: 48ch;
  }

  .remodeling-room-text p:last-child {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .remodeling-room-timeline {
    color: var(--color-accent-dark);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }



  .remodeling-behind {
    padding-block: var(--space-9);
  }

  .remodeling-behind-inner {
    display: grid;
    gap: var(--space-5);
  }

  .remodeling-behind-inner h2 {
    font-size: var(--step-4);
  }

  .remodeling-behind-inner p {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
