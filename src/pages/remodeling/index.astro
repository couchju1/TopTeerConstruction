---
import Service from '../../layouts/Service.astro';
import Fact from '../../components/Fact.astro';
import FaqSection from '../../components/FaqSection.astro';
import Picture from '../../components/Picture.astro';
import Section from '../../components/Section.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { remodelingCopy as copy } from '../../lib/service-copy';
import hero from '../../assets/photos/placeholder-hero.jpg';
import square from '../../assets/photos/placeholder-square.jpg';
---
<Service slug="remodeling" hero="split" photo={hero} {...copy}>
  {
    copy.rooms.map((room, index) => (
      <Section tone={index % 2 === 0 ? 'white' : 'limestone'} grid={index % 2 === 0 ? '7-5' : '5-7'} aria-labelledby={`room-${index}`} class="remodel-room">
        <div class:list={['remodel-room-text', index % 2 === 1 && 'remodel-room-text-right']}>
          <p class="remodel-room-timeline"><Fact text={room.timeline} name={`${room.name} timeline`} /></p>
          <h2 id={`room-${index}`}>{room.name}</h2>
          <p><Fact text={room.body} name={`${room.name} body`} /></p>
        </div>
        <div class="remodel-room-photo">
          <Picture src={square} alt={`[CONFIRM: real photo] Placeholder for a ${room.name.toLowerCase()} photo`} sizes="(min-width: 48rem) 40vw, 100vw" />
        </div>
      </Section>
    ))
  }

  <Section tone="spruce" width="full" aria-labelledby="behind-wall" class="remodel-behind">
    <div class="container remodel-behind-inner">
      <h2 id="behind-wall">{copy.behindHeading}</h2>
      <p><Fact text={copy.behindBody} name="Behind the wall body" /></p>
    </div>
  </Section>

  <ServiceGallery service="remodeling" heading={copy.galleryHeading} />
  <FaqSection heading={copy.faqHeading} items={copy.faqs} />
</Service>

<style>
  .remodel-room-text {
    display: grid;
    gap: var(--space-3);
    max-width: 48ch;
  }

  .remodel-room-text p:last-child {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .remodel-room-timeline {
    color: var(--color-accent-dark);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .remodel-room-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .remodel-room-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .remodel-room-text-right {
      order: 2;
    }
  }

  .remodel-behind {
    padding-block: var(--space-9);
  }

  .remodel-behind-inner {
    display: grid;
    gap: var(--space-5);
  }

  .remodel-behind-inner h2 {
    font-size: var(--step-4);
  }

  .remodel-behind-inner p {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
