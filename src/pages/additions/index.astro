---
import Service from '../../layouts/Service.astro';
import Fact from '../../components/Fact.astro';
import FaqSection from '../../components/FaqSection.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import Section from '../../components/Section.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { additionsCopy as copy } from '../../lib/service-copy';
import hero from '../../assets/photos/placeholder-hero.jpg';
---
<Service slug="additions" hero="split" photo={hero} {...copy}>
  <Section tone="white" grid="5-7" aria-labelledby="why-add" class="additions-why">
    <h2 id="why-add"><Fact text={copy.whyHeading} name="Why heading" /></h2>
    <p><Fact text={copy.whyBody} name="Why body" /></p>
  </Section>

  <Section grid="5-7" aria-labelledby="sketch-to-keys" class="additions-steps">
    <h2 id="sketch-to-keys">{copy.stepsHeading}</h2>
    <ProcessSteps steps={copy.steps} layout="vertical" />
  </Section>

  <ServiceGallery service="additions" heading={copy.galleryHeading} />
  <FaqSection heading={copy.faqHeading} items={copy.faqs} tone="white" />
</Service>

<style>
  .additions-why p {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .additions-steps :global(.section-grid) {
    align-items: start;
  }

  @media (min-width: 48rem) {
    .additions-steps h2 {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
