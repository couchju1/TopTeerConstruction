---
import Fact from './Fact.astro';
import { location, telHref } from '../lib/config';
import { ACCEPTED_EXTENSIONS, ACCEPTED_TYPES, form, formSettings, limits } from '../lib/form';

interface Props {
  serverErrorText: string;
  invalidText: string;
}

const { serverErrorText, invalidText } = Astro.props;
const accept = [...ACCEPTED_TYPES, ...ACCEPTED_EXTENSIONS].join(',');
---
<form
  class="estimate-form"
  action={form.endpoint}
  method="post"
  enctype="multipart/form-data"
  data-estimate-form
  data-settings={JSON.stringify(formSettings)}
>
  <div id="estimate-error" class="estimate-alert" tabindex="-1" data-alert="invalid">
    <p>{invalidText}</p>
  </div>
  <div id="estimate-server-error" class="estimate-alert" tabindex="-1" data-alert="server">
    <p><Fact text={serverErrorText} name="Form server error" /> <a href={telHref} data-track="call" data-track-location="page"><Fact field="contact.phoneDisplay" /></a></p>
  </div>

  <div class="estimate-field">
    <label for="est-name">Name</label>
    <input id="est-name" name="name" type="text" autocomplete="name" required maxlength={limits.name} aria-describedby="est-name-error" />
    <p class="estimate-error" id="est-name-error" aria-live="polite"></p>
  </div>

  <div class="estimate-row">
    <div class="estimate-field">
      <label for="est-phone">Phone</label>
      <input id="est-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="est-phone-error" />
      <p class="estimate-error" id="est-phone-error" aria-live="polite"></p>
    </div>
    <div class="estimate-field">
      <label for="est-email">Email <span class="estimate-optional">(optional)</span></label>
      <input id="est-email" name="email" type="email" autocomplete="email" maxlength={limits.email} aria-describedby="est-email-error" />
      <p class="estimate-error" id="est-email-error" aria-live="polite"></p>
    </div>
  </div>

  <div class="estimate-row">
    <div class="estimate-field">
      <label for="est-town">Town</label>
      <input id="est-town" name="town" type="text" autocomplete="address-level2" list="est-towns" required maxlength={limits.town} aria-describedby="est-town-error" />
      <datalist id="est-towns">
        {location.serviceTowns.map((town) => <option value={town} />)}
      </datalist>
      <p class="estimate-error" id="est-town-error" aria-live="polite"></p>
    </div>
    <div class="estimate-field">
      <label for="est-type">Type of job</label>
      <select id="est-type" name="projectType" required aria-describedby="est-type-error">
        <option value="">Choose one</option>
        {form.projectTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
      <p class="estimate-error" id="est-type-error" aria-live="polite"></p>
    </div>
  </div>

  <div class="estimate-field">
    <label for="est-details">What do you have in mind? <span class="estimate-optional">(optional)</span></label>
    <textarea id="est-details" name="details" rows="5" maxlength={limits.details} aria-describedby="est-details-error"></textarea>
    <p class="estimate-error" id="est-details-error" aria-live="polite"></p>
  </div>

  <div class="estimate-field">
    <label for="est-photos">Photos <span class="estimate-optional">(optional, up to {form.maxFiles}, {form.maxFileMB} MB each)</span></label>
    <input id="est-photos" name="photos[]" type="file" multiple accept={accept} aria-describedby="est-photos-hint est-photos-error" />
    <p class="estimate-hint" id="est-photos-hint">A few phone photos of the space help me price it.</p>
    <p class="estimate-error" id="est-photos-error" aria-live="polite"></p>
  </div>

  <div class="estimate-hp" aria-hidden="true">
    <label for="est-company">Company</label>
    <input id="est-company" name={form.honeypotField} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="elapsed" value="" data-elapsed />

  <button class="estimate-submit" type="submit" data-submit>Send my request</button>
</form>

<style>
  .estimate-form {
    display: grid;
    gap: var(--space-5);
  }

  .estimate-row {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 36rem) {
    .estimate-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .estimate-field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .estimate-field label {
    font-weight: 600;
  }

  .estimate-optional {
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .estimate-field input:not([type="file"]),
  .estimate-field select,
  .estimate-field textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .estimate-field textarea {
    resize: vertical;
  }

  .estimate-field input[type="file"] {
    min-height: 48px;
    padding: var(--space-2) 0;
  }

  .estimate-field :is(input, select, textarea):focus-visible {
    border-color: var(--color-ink);
  }

  .estimate-field [aria-invalid="true"] {
    border: 2px solid var(--color-error);
  }

  .estimate-hint {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .estimate-error {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-error);
  }

  .estimate-error:empty {
    display: none;
  }

  .estimate-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .estimate-alert {
    display: none;
    padding: var(--space-4);
    border-left: 4px solid var(--color-error);
    background: var(--color-white);
  }

  .estimate-alert:target,
  .estimate-alert.is-shown {
    display: block;
  }

  .estimate-alert a {
    font-weight: 600;
  }

  .estimate-submit {
    justify-self: start;
    min-height: 52px;
    padding: 0 var(--space-6);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    font-size: var(--step-1);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .estimate-submit:hover:not(:disabled) {
    background: var(--color-accent-hover);
  }

  .estimate-submit:active:not(:disabled) {
    transform: translateY(1px);
  }

  .estimate-submit:disabled {
    cursor: progress;
    background: var(--color-ink-muted);
  }
</style>

<script>
  type Settings = {
    maxFiles: number;
    maxFileBytes: number;
    acceptedTypes: string[];
    limits: { name: number; town: number; email: number; details: number };
    messages: Record<string, string>;
  };

  const form = document.querySelector<HTMLFormElement>('[data-estimate-form]');

  if (form) {
    const settings: Settings = JSON.parse(form.dataset.settings ?? '{}');
    const m = settings.messages;
    const loadedAt = performance.now();
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = submit.textContent ?? '';
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    const alerts = {
      invalid: form.querySelector<HTMLElement>('[data-alert="invalid"]')!,
      server: form.querySelector<HTMLElement>('[data-alert="server"]')!,
    };
    const extensions = ['.jpg', '.jpeg', '.png', '.heic', '.webp'];

    form.noValidate = true;

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;
    const value = (name: string) => (field(name)?.value ?? '').trim();

    const rules: Record<string, () => string> = {
      name: () => (value('name') === '' || value('name').length > settings.limits.name ? m.name : ''),
      phone: () => {
        let digits = value('phone').replace(/\D+/g, '');
        if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
        return digits.length === 10 ? '' : m.phone;
      },
      email: () => {
        const v = value('email');
        if (v === '') return '';
        return v.length <= settings.limits.email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : m.email;
      },
      town: () => (value('town') === '' || value('town').length > settings.limits.town ? m.town : ''),
      projectType: () => (value('projectType') === '' ? m.projectType : ''),
      details: () => (value('details').length > settings.limits.details ? m.details : ''),
      'photos[]': () => {
        const files = Array.from(field('photos[]')?.files ?? []);
        if (files.length > settings.maxFiles) return m.photosCount;
        for (const file of files) {
          if (file.size > settings.maxFileBytes) return m.photosSize;
          const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
          if (!settings.acceptedTypes.includes(file.type) && !extensions.includes(ext)) return m.photosType;
        }
        return '';
      },
    };

    const errorEl = (input: HTMLElement) => document.getElementById(`${input.id}-error`);

    const setError = (name: string, message: string) => {
      const input = field(name);
      if (!input) return;
      const el = errorEl(input);
      if (el && el.textContent !== message) el.textContent = message;
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    };

    const check = (name: string) => {
      const message = rules[name]();
      setError(name, message);
      return message;
    };

    for (const name of Object.keys(rules)) {
      const input = field(name);
      input?.addEventListener('blur', () => check(name));
      input?.addEventListener('change', () => {
        if (input.getAttribute('aria-invalid') === 'true' || input.type === 'file') check(name);
      });
      input?.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') check(name);
      });
    }

    const showAlert = (kind: 'invalid' | 'server' | null) => {
      alerts.invalid.classList.toggle('is-shown', kind === 'invalid');
      alerts.server.classList.toggle('is-shown', kind === 'server');
      if (kind) alerts[kind].focus();
    };

    const reset = () => {
      submit.disabled = false;
      submit.textContent = submitLabel;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showAlert(null);
      const invalid = Object.keys(rules).filter((name) => check(name) !== '');
      if (invalid.length > 0) {
        field(invalid[0])?.focus();
        return;
      }

      elapsed.value = String(Math.round(performance.now() - loadedAt));
      submit.disabled = true;
      submit.textContent = 'Sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => null);
        if (result?.ok) {
          window.location.assign(result.redirect);
          return;
        }
        const serverErrors: Record<string, string> = result?.errors ?? {};
        const fieldNames = Object.keys(serverErrors).map((k) => (k === 'photos' ? 'photos[]' : k)).filter((k) => k in rules);
        reset();
        if (fieldNames.length > 0) {
          for (const name of fieldNames) setError(name, serverErrors[name === 'photos[]' ? 'photos' : name]);
          field(fieldNames[0])?.focus();
          return;
        }
        showAlert('server');
      } catch {
        reset();
        showAlert('server');
      }
    });
  }
</script>
