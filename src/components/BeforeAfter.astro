---
import type { ImageMetadata } from 'astro';
import Fact from './Fact.astro';
import Picture from './Picture.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
}

const { before, after, beforeAlt, afterAlt, caption } = Astro.props;
---
<figure class="before-after" data-before-after>
  <div class="before-after-stage">
    <div class="before-after-pane before-after-before">
      <Picture src={before} alt={beforeAlt} sizes="(min-width: 76rem) 76rem, 100vw" />
      <span class="before-after-label">Before</span>
    </div>
    <div class="before-after-pane before-after-after">
      <Picture src={after} alt={afterAlt} sizes="(min-width: 76rem) 76rem, 100vw" />
      <span class="before-after-label">After</span>
    </div>
    <input
      class="before-after-range"
      type="range"
      min="0"
      max="100"
      step="5"
      value="50"
      aria-label="Before and after slider"
      aria-valuetext="Showing half before, half after"
      data-before-after-range
    />
  </div>
  {caption && <figcaption class="before-after-caption"><Fact text={caption} name="BeforeAfter caption" /></figcaption>}
</figure>

<style>
  .before-after-stage {
    display: grid;
    gap: var(--space-4);
  }

  .before-after-pane {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-line);
  }

  .before-after-pane :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after-label {
    position: absolute;
    top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    background: var(--color-band);
    color: var(--color-on-band);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .before-after-before .before-after-label {
    left: var(--space-3);
  }

  .before-after-after .before-after-label {
    right: var(--space-3);
  }

  .before-after-range {
    display: none;
  }

  .before-after-caption {
    margin-top: var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  :global(.js) .before-after-stage {
    --pos: 50%;
    position: relative;
    gap: 0;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
  }

  :global(.js) .before-after-pane {
    grid-area: 1 / 1;
  }

  :global(.js) .before-after-after {
    clip-path: inset(0 0 0 var(--pos));
  }

  :global(.js) .before-after-stage::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--color-white);
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.35);
    pointer-events: none;
  }

  :global(.js) .before-after-range {
    display: block;
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 44px;
    margin: 0;
    transform: translateY(-50%);
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: ew-resize;
  }

  .before-after-range::-webkit-slider-runnable-track {
    height: 44px;
    background: transparent;
  }

  .before-after-range::-moz-range-track {
    height: 44px;
    background: transparent;
  }

  .before-after-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 44px;
    height: 44px;
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .before-after-range::-moz-range-thumb {
    width: 44px;
    height: 44px;
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .before-after-range:focus-visible {
    box-shadow: none;
  }

  .before-after-range:focus-visible::-webkit-slider-thumb {
    box-shadow: var(--shadow-focus);
  }

  .before-after-range:focus-visible::-moz-range-thumb {
    box-shadow: var(--shadow-focus);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-before-after]')) {
    const stage = root.querySelector<HTMLElement>('.before-after-stage');
    const range = root.querySelector<HTMLInputElement>('[data-before-after-range]');
    if (!stage || !range) continue;

    const describe = (value: number) => {
      if (value === 0) return 'Showing all after';
      if (value === 100) return 'Showing all before';
      return `Showing ${value} percent before, ${100 - value} percent after`;
    };

    const update = () => {
      const value = Number(range.value);
      stage.style.setProperty('--pos', `${value}%`);
      range.setAttribute('aria-valuetext', describe(value));
    };

    const setFromPointer = (event: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      const ratio = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
      range.value = String(Math.round((ratio * 100) / 5) * 5);
      update();
    };

    stage.addEventListener('pointerdown', (event) => {
      if (event.target === range) return;
      stage.setPointerCapture(event.pointerId);
      setFromPointer(event);
      range.focus({ preventScroll: true });
    });

    stage.addEventListener('pointermove', (event) => {
      if (stage.hasPointerCapture(event.pointerId)) setFromPointer(event);
    });

    range.addEventListener('input', update);
    update();
  }
</script>
