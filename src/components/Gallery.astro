---
import { getImage } from 'astro:assets';
import Fact from './Fact.astro';
import Picture from './Picture.astro';
import { services } from '../lib/config';
import type { GalleryPhoto } from '../lib/projects';

interface Props {
  photos: GalleryPhoto[];
  filters?: boolean;
  emptyMessage?: string;
  label: string;
}

const { photos, filters = false, emptyMessage = '', label } = Astro.props;

const items = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.src, width: Math.min(photo.src.width, 1800), format: 'webp' });
    return { ...photo, large: large.src, text: `${photo.town}. ${photo.caption}` };
  }),
);
---
<div class="gallery" data-gallery>
  {
    filters && (
      <div class="gallery-filters" role="group" aria-label="Filter by service" data-gallery-filters>
        <button type="button" class="gallery-chip" aria-pressed="true" data-filter="all">All</button>
        {services.map((s) => (
          <button type="button" class="gallery-chip" aria-pressed="false" data-filter={s.slug}>
            {s.name}
          </button>
        ))}
      </div>
    )
  }

  <p class="gallery-status visually-hidden" aria-live="polite" data-gallery-status></p>

  <ul class="gallery-grid" role="list" aria-label={label}>
    {
      items.map((item, index) => (
        <li class="gallery-item" data-service={item.service}>
          <figure>
            <a
              class="gallery-thumb"
              href={item.large}
              data-index={index}
              data-large={item.large}
              data-alt={item.alt}
              data-caption={item.text}
            >
              <Picture
                src={item.src}
                alt={item.alt}
                sizes="(min-width: 64rem) 25rem, (min-width: 36rem) 50vw, 100vw"
              />
            </a>
            <figcaption class="gallery-caption">{item.text}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  {
    emptyMessage && (
      <p class="gallery-empty" hidden={photos.length > 0} data-gallery-empty>
        <Fact text={emptyMessage} name="Gallery empty state" />
      </p>
    )
  }

  <dialog class="gallery-lightbox" aria-label="Photo viewer" data-gallery-dialog>
    <div class="gallery-lightbox-frame">
      <img class="gallery-lightbox-img" alt="" data-gallery-img />
      <p class="gallery-lightbox-caption" data-gallery-caption></p>
      <p class="gallery-lightbox-count" data-gallery-count></p>
    </div>
    <button type="button" class="gallery-lightbox-btn gallery-lightbox-prev" data-gallery-prev>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
      </svg>
      <span class="visually-hidden">Previous photo</span>
    </button>
    <button type="button" class="gallery-lightbox-btn gallery-lightbox-next" data-gallery-next>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
      </svg>
      <span class="visually-hidden">Next photo</span>
    </button>
    <button type="button" class="gallery-lightbox-btn gallery-lightbox-close" data-gallery-close>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
      </svg>
      <span class="visually-hidden">Close</span>
    </button>
  </dialog>
</div>

<style>
  .gallery-filters {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  :global(.js) .gallery-filters {
    display: flex;
  }

  .gallery-chip {
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--step--1);
    font-weight: 600;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .gallery-chip:hover {
    background: var(--color-white);
  }

  .gallery-chip[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .gallery-grid {
    columns: 1;
    column-gap: var(--space-5);
  }

  @media (min-width: 36rem) {
    .gallery-grid {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery-grid {
      columns: 3;
    }
  }

  .gallery-item {
    break-inside: avoid;
    margin-bottom: var(--space-5);
  }

  .gallery-item[hidden] {
    display: none;
  }

  .gallery-thumb {
    display: block;
    overflow: hidden;
    background: var(--color-line);
  }

  .gallery-thumb :global(img) {
    width: 100%;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .gallery-thumb:hover :global(img) {
    transform: scale(1.02);
  }

  .gallery-thumb:focus-visible {
    border-radius: 0;
  }

  .gallery-caption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .gallery-empty {
    padding: var(--space-6) 0;
    color: var(--color-ink-muted);
  }

  .gallery-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--space-7) var(--space-4) var(--space-5);
    border: 0;
    background: var(--color-band-deep);
    color: var(--color-on-band);
  }

  .gallery-lightbox::backdrop {
    background: rgb(10 10 10 / 0.9);
  }

  .gallery-lightbox-frame {
    display: grid;
    grid-template-rows: 1fr auto auto;
    justify-items: center;
    gap: var(--space-3);
    height: 100%;
  }

  .gallery-lightbox-img {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .gallery-lightbox-caption {
    max-width: 60ch;
    text-align: center;
  }

  .gallery-lightbox-count {
    font-size: var(--step--1);
    color: #bdbdb8;
  }

  .gallery-lightbox-btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid rgb(237 237 234 / 0.5);
    border-radius: var(--radius-pill);
    background: rgb(10 10 10 / 0.6);
    color: var(--color-on-band);
  }

  .gallery-lightbox-btn:hover {
    border-color: var(--color-on-band);
  }

  .gallery-lightbox-close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .gallery-lightbox-prev,
  .gallery-lightbox-next {
    top: 50%;
    margin-top: -24px;
  }

  .gallery-lightbox-prev {
    left: var(--space-3);
  }

  .gallery-lightbox-next {
    right: var(--space-3);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.gallery-item'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const empty = root.querySelector<HTMLElement>('[data-gallery-empty]');
    const status = root.querySelector<HTMLElement>('[data-gallery-status]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const img = root.querySelector<HTMLImageElement>('[data-gallery-img]');
    const caption = root.querySelector<HTMLElement>('[data-gallery-caption]');
    const count = root.querySelector<HTMLElement>('[data-gallery-count]');
    if (!dialog || !img || !caption || !count) continue;

    let current = 0;
    let opener: HTMLElement | null = null;

    const visibleThumbs = () =>
      items.filter((item) => !item.hidden).map((item) => item.querySelector<HTMLAnchorElement>('.gallery-thumb')!);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        for (const item of items) item.hidden = filter !== 'all' && item.dataset.service !== filter;
        const shown = visibleThumbs().length;
        if (empty) empty.hidden = shown > 0;
        if (status) status.textContent = shown === 1 ? 'Showing 1 photo' : `Showing ${shown} photos`;
      });
    }

    const show = (index: number) => {
      const thumbs = visibleThumbs();
      current = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[current];
      img.src = thumb.dataset.large ?? thumb.href;
      img.alt = thumb.dataset.alt ?? '';
      caption.textContent = thumb.dataset.caption ?? '';
      count.textContent = `${current + 1} of ${thumbs.length}`;
    };

    root.addEventListener('click', (event) => {
      const thumb = (event.target as Element).closest<HTMLAnchorElement>('.gallery-thumb');
      if (!thumb || !root.contains(thumb)) return;
      event.preventDefault();
      opener = thumb;
      show(visibleThumbs().indexOf(thumb));
      dialog.showModal();
      root.querySelector<HTMLButtonElement>('[data-gallery-close]')?.focus();
    });

    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
    root.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => opener?.focus());
  }
</script>
