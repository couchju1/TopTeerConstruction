---
import Fact from './Fact.astro';
import { reviews, type Review } from '../lib/config';

interface Props {
  items?: Review[];
}

const { items = reviews.items } = Astro.props;
const show = items.length >= reviews.minimumToShow;
---
{
  show && (
    <section class="reviews" aria-labelledby="reviews-heading">
      <h2 id="reviews-heading" class="reviews-heading">
        <Fact field="copy.reviewsHeading" />
      </h2>
      <ul class="reviews-list" role="list">
        {items.map((review) => (
          <li class="reviews-item">
            <figure>
              <blockquote class="reviews-quote">
                <p>{review.text}</p>
              </blockquote>
              <figcaption class="reviews-cite">
                {review.name}, {review.town}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .reviews-heading {
    margin-bottom: var(--space-6);
  }

  .reviews-list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .reviews-list {
      grid-template-columns: 7fr 5fr;
    }

    .reviews-item:first-child {
      grid-row: span 2;
    }
  }

  .reviews-item {
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
  }

  .reviews-item:first-child .reviews-quote {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
  }

  .reviews-cite {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-ink-muted);
  }
</style>
