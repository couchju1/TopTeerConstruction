---
import type { ImageMetadata } from 'astro';
import { Picture as AstroPicture } from 'astro:assets';

type Base = {
  src: ImageMetadata;
  sizes?: string;
  priority?: boolean;
  class?: string;
};

type Props = Base & ({ alt: string; decorative?: false } | { alt: ''; decorative: true });

const { src, alt, decorative = false, sizes = '100vw', priority = false, class: className } = Astro.props;

if (typeof alt !== 'string') throw new Error('Picture: alt is required');
if (alt.trim() === '' && !decorative) {
  throw new Error(`Picture: empty alt needs decorative={true} (${src.src})`);
}

const widths = [480, 800, 1200, 1800].filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
---
<AstroPicture
  src={src}
  alt={decorative ? '' : alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={className}
/>
