---
import Fact from './Fact.astro';
import type { FaqItem } from '../lib/faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const schema = Astro.slots.has('default') ? await Astro.slots.render('default', [items]) : '';
---
<div class="accordion">
  {
    items.map((item, index) => (
      <details class="accordion-item">
        <summary class="accordion-summary">
          <span><Fact text={item.question} name={`FAQ ${index + 1} question`} /></span>
          <span class="accordion-marker" aria-hidden="true" />
        </summary>
        <div class="accordion-answer">
          <p><Fact text={item.answer} name={`FAQ ${index + 1} answer`} /></p>
        </div>
      </details>
    ))
  }
</div>
<Fragment set:html={schema} />

<style>
  .accordion {
    border-top: 1px solid var(--color-ink);
  }

  .accordion-item {
    border-bottom: 1px solid var(--color-line);
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    padding: var(--space-4) 0;
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: var(--leading-tight);
    cursor: pointer;
    list-style: none;
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary:hover span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .accordion-summary:focus-visible {
    box-shadow: var(--shadow-focus);
  }

  .accordion-marker {
    position: relative;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .accordion-marker::before,
  .accordion-marker::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: var(--color-accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .accordion-marker::after {
    transform: rotate(90deg);
  }

  .accordion-item[open] .accordion-marker::after {
    transform: rotate(0deg);
  }

  .accordion-answer {
    padding-bottom: var(--space-5);
    max-width: 65ch;
  }
</style>
