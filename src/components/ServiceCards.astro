---
import type { ImageMetadata } from 'astro';
import Picture from './Picture.astro';
import { services } from '../lib/config';

interface Props {
  photos?: Partial<Record<string, ImageMetadata>>;
}

const { photos = {} } = Astro.props;

const icons: Record<string, string> = {
  remodeling: 'M4 20h16M6 20V9l6-5 6 5v11M10 20v-6h4v6',
  additions: 'M3 20h18M5 20v-9l5-4 5 4v9M15 11h5v9M17.5 4v5M15 6.5h5',
  decks: 'M3 9h18M3 13h18M5 13v7M19 13v7M12 13v7M3 5h18',
  siding: 'M4 20V10l8-6 8 6v10H4zM4 13h16M4 16h16M4 19h16',
  'new-construction': 'M4 20V10l8-6 8 6v10M8 20v-7M12 20v-9M16 20v-7M4 14h16',
};
---
<ul class="service-cards" role="list">
  {
    services.map((service) => {
      const photo = photos[service.slug];
      return (
        <li class:list={['service-cards-item', service.isPrimary && 'service-cards-item-primary']}>
          <a class:list={['service-cards-link', photo ? 'service-cards-link-photo' : 'service-cards-link-plain']} href={`/${service.slug}/`}>
            {photo ? (
              <span class="service-cards-photo">
                <Picture
                  src={photo}
                  alt=""
                  decorative
                  sizes={service.isPrimary ? '(min-width: 64rem) 38rem, 100vw' : '(min-width: 64rem) 19rem, (min-width: 36rem) 50vw, 100vw'}
                />
              </span>
            ) : (
              <svg class="service-cards-icon" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={icons[service.slug] ?? icons.remodeling} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
            )}
            <span class="service-cards-body">
              <span class="service-cards-name">{service.name}</span>
              <span class="service-cards-desc">{service.short}</span>
              <span class="service-cards-more">
                Learn more
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .service-cards {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 36rem) {
    .service-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-cards-item-primary {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .service-cards {
      grid-template-columns: 2fr 1fr 1fr;
      grid-auto-rows: minmax(15rem, auto);
    }

    .service-cards-item-primary {
      grid-column: 1;
      grid-row: span 2;
    }
  }

  .service-cards-item {
    display: flex;
  }

  .service-cards-link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    min-height: 15rem;
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-on-band);
  }

  .service-cards-item-primary .service-cards-link {
    min-height: 22rem;
    padding: var(--space-6);
  }

  .service-cards-link-plain {
    justify-content: space-between;
    background: var(--color-band);
    border-top: 4px solid var(--color-accent);
  }

  .service-cards-photo {
    position: absolute;
    inset: 0;
  }

  .service-cards-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .service-cards-link-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(10 10 10 / 0.9) 0%, rgb(10 10 10 / 0.55) 45%, rgb(10 10 10 / 0.05) 80%);
  }

  .service-cards-icon {
    color: var(--color-accent-on-band);
  }

  .service-cards-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-2);
  }

  .service-cards-name {
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }

  .service-cards-item-primary .service-cards-name {
    font-size: var(--step-3);
  }

  .service-cards-desc {
    max-width: 36ch;
  }

  .service-cards-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--color-white);
  }

  .service-cards-more svg {
    color: var(--color-accent-on-band);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .service-cards-link:hover .service-cards-photo :global(img),
  .service-cards-link:focus-visible .service-cards-photo :global(img) {
    transform: scale(1.03);
  }

  .service-cards-link:hover .service-cards-more svg,
  .service-cards-link:focus-visible .service-cards-more svg {
    transform: translateX(4px);
  }

  .service-cards-link:hover .service-cards-name,
  .service-cards-link:focus-visible .service-cards-name {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-on-band);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
