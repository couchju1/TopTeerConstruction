---
import { assertLaunchReady, fact, isPlaceholder } from '../lib/config';

type Props = { field: string } | { text: string; name: string };

const props = Astro.props;
let label: string;
let value: string;
let placeholder: boolean;

if ('field' in props) {
  label = props.field;
  ({ value, placeholder } = fact(props.field));
} else {
  label = `${props.name} on ${Astro.url.pathname}`;
  assertLaunchReady(label, props.text);
  value = props.text;
  placeholder = isPlaceholder(props.text);
}
---
{placeholder ? <span class="fact-placeholder" data-field={label} title={label}>{value}</span> : value}
